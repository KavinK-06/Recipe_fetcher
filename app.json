{
  "expo": {
    "name": "Rasoi",
    "slug": "rasoi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rasoi",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rasoi.app"
    },
    "android": {
      "package": "com.rasoi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A0A0E"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 300,
          "backgroundColor": "#1A0A0E",
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rasoi uses your photos to scan a dish and estimate its calories.",
          "cameraPermission": "Rasoi uses your camera to scan a dish and estimate its calories."
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "clerkPublishableKey": "$(EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY)",
      "supabaseUrl": "$(EXPO_PUBLIC_SUPABASE_URL)",
      "supabaseAnonKey": "$(EXPO_PUBLIC_SUPABASE_ANON_KEY)"
    }
  }
}
