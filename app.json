{
  "expo": {
    "name": "Rasoi",
    "slug": "rasoi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rasoi",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f19594c6-2de6-4f2c-b749-1ae009601c13"
    },
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rasoi.app"
    },
    "android": {
      "package": "com.rasoi.myapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A0A0E"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 300,
          "backgroundColor": "#1A0A0E",
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rasoi uses your photos to scan a dish and estimate its calories.",
          "cameraPermission": "Rasoi uses your camera to scan a dish and estimate its calories."
        }
      ],
      "expo-iap",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "clerkPublishableKey": "$(EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY)",
      "supabaseUrl": "$(EXPO_PUBLIC_SUPABASE_URL)",
      "supabaseAnonKey": "$(EXPO_PUBLIC_SUPABASE_ANON_KEY)",
      "router": {},
      "eas": {
        "projectId": "f19594c6-2de6-4f2c-b749-1ae009601c13"
      }
    },
    "owner": "kavin_06"
  }
}
